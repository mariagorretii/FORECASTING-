> # memodelkan SARIMA
> library(forecast)
>  results <- data.frame(Model = character(),
+  AIC = numeric(),
+ Shapiro_p = numeric(), LjungBox_p = numeric(),stringsAsFactors = FALSE)
> p_vals <- 0:3
> d_vals <- 1
> q_vals <- 0:3
> 
> P_vals <- 0:1
> D_vals <- 1
> Q_vals <- 0:1
> 
>  for (p in p_vals) {
+  for (d in d_vals) {
+  for (q in q_vals) {
+  for (P in P_vals) {
+  for (D in D_vals) {
+  for (Q in Q_vals) {
+ 
+  fit <- tryCatch({
+  Arima(ts_data,
+  order = c(p,d,q),
+  seasonal = list(order = c(P,D,Q), period = 12))
+  }, error = function(e) NULL)
+ 
+ if (!is.null(fit)) {
+ res <- residuals(fit)
+ aic_val <- AIC(fit)
+ shapiro_p <- tryCatch({ shapiro.test(res)$p.value},  error = function(e) NA)
+ ljung_p <- tryCatch({Box.test(res, lag = 12, type = "Ljung-Box")$p.value}, error = function(e) NA)
+ results <- rbind(results, data.frame( Model = paste0("(",p,",",d,",",q,")(", P,",",D,",",Q,")[12]"),
+ AIC = aic_val, Shapiro_p = shapiro_p, LjungBox_p = ljung_p))}}}}}}}
