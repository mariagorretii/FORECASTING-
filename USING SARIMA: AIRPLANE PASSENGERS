> # UBAH DATA DALAM BENTUK TIME SERIES
> ts_data <- ts(data$total_passengers, start = c(1949,1), frequency = 12)
> plot.ts(ts_data)
> 
> # IDENTIFIKASI MODEL
> library(tseries)
> acf(ts_data)
> pacf(ts_data)
