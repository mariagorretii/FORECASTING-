> 
> # MEMBAGI DATA TRAIN DAN TEST
> train <- window(ts_data, end = c(1959,12))
> test <- window(ts_data, start = c(1960,1))
> plot.ts(train)
> 
> ## MENGAMBIL NILAI LOGARITMA PADA DATA TRAIN KARENA PLOT DATA MEMILIKI FLUKTUASI YANG BESAR
> logtrain <- log(train)
> difflogtrain1<-diff(logtrain)
> difflogtrain1<-diff(logtrain, n=1)
> plot.ts(difflogtrain1)
> acf(difflogtrain1)
> pacf(difflogtrain1)
